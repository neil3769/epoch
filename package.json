{
  "name": "epoch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify-content": "tsx scripts/verify-content.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
